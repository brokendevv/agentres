{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and active organization context",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "activeOrgId": { "type": "string", "maxLength": 128 },
        "activeBranchId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "activeOrgId", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Restaurant tenant workspace with plan, currency, and owner UID",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "currency": { "type": "string", "enum": ["MAD", "USD", "EUR", "GBP"] },
        "plan": { "type": "string", "enum": ["free", "pro", "business", "ultra"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "trialing", "past_due", "canceled", "expired"] },
        "aiQueriesUsedThisMonth": { "type": "number" },
        "country": { "type": "string", "maxLength": 64 },
        "timezone": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerUid", "currency", "plan", "subscriptionStatus", "aiQueriesUsedThisMonth", "country", "timezone", "createdAt", "updatedAt"]
    },
    "Member": {
      "title": "Member",
      "description": "Organization staff membership and RBAC role",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "manager", "finance", "inventory", "staff"] },
        "branchId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "invited", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "orgId", "email", "displayName", "role", "branchId", "status", "createdAt", "updatedAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Restaurant physical branch or location",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "city": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 250 },
        "timezone": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 40 },
        "capacity": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "name", "city", "address", "timezone", "phone", "capacity", "createdAt", "updatedAt"]
    },
    "Ingredient": {
      "title": "Ingredient",
      "description": "Inventory stock item with minor-unit valuation and threshold levels",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "sku": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 64 },
        "baseUnit": { "type": "string", "enum": ["kg", "g", "L", "mL", "unit"] },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "reorderTarget": { "type": "number" },
        "unitCostMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "preferredSupplierId": { "type": "string", "maxLength": 128 },
        "storageLocation": { "type": "string", "maxLength": 100 },
        "expiryDate": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "branchId", "name", "sku", "category", "baseUnit", "currentStock", "minStock", "reorderTarget", "unitCostMinor", "currency", "preferredSupplierId", "storageLocation", "expiryDate", "updatedBy", "createdAt", "updatedAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Approved restaurant vendor and supplier contact record",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 80 },
        "contactName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "currency": { "type": "string", "maxLength": 8 },
        "paymentTerms": { "type": "string", "maxLength": 80 },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "name", "category", "contactName", "email", "phone", "currency", "paymentTerms", "rating", "createdAt", "updatedAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Purchase order and delivery receipt record",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 120 },
        "invoiceRef": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["draft", "ordered", "received", "rejected"] },
        "ingredientId": { "type": "string", "maxLength": 128 },
        "ingredientName": { "type": "string", "maxLength": 120 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "g", "L", "mL", "unit"] },
        "unitPriceMinor": { "type": "number" },
        "taxMinor": { "type": "number" },
        "discountMinor": { "type": "number" },
        "totalMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "purchaseDate": { "type": "string", "maxLength": 40 },
        "receivedAt": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "branchId", "supplierId", "supplierName", "invoiceRef", "status", "ingredientId", "ingredientName", "quantity", "unit", "unitPriceMinor", "taxMinor", "discountMinor", "totalMinor", "currency", "purchaseDate", "receivedAt", "notes", "createdBy", "createdAt", "updatedAt"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Immutable inventory ledger movement record",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "branchId": { "type": "string", "maxLength": 128 },
        "ingredientId": { "type": "string", "maxLength": 128 },
        "ingredientName": { "type": "string", "maxLength": 120 },
        "movementType": { "type": "string", "enum": ["opening", "receipt", "consumption", "transfer", "waste", "stocktake", "return", "correction"] },
        "quantityDelta": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "g", "L", "mL", "unit"] },
        "balanceAfter": { "type": "number" },
        "referenceId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 300 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "branchId", "ingredientId", "ingredientName", "movementType", "quantityDelta", "unit", "balanceAfter", "referenceId", "reason", "actorUid", "actorName", "createdAt"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Dish recipe and food cost specification",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "dishName": { "type": "string", "maxLength": 120 },
