      "required": ["orgId", "dishName", "category", "portionsYield", "sellingPriceMinor", "estimatedCostMinor", "currency", "primaryIngredientId", "primaryIngredientName", "primaryQuantity", "primaryUnit", "instructions", "version", "createdAt", "updatedAt"]
    },
    "TipRecord": {
      "title": "TipRecord",
