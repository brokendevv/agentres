        "sellingPriceMinor": { "type": "number" },
        "estimatedCostMinor": { "type": "number" },
        "currency": { "type": "string", "maxLength": 8 },
        "primaryIngredientId": { "type": "string", "maxLength": 128 },
        "primaryIngredientName": { "type": "string", "maxLength": 120 },
        "primaryQuantity": { "type": "number" },
        "primaryUnit": { "type": "string", "enum": ["kg", "g", "L", "mL", "unit"] },
        "instructions": { "type": "string", "maxLength": 600 },
        "version": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
