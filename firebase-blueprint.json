        "notes": { "type": "string", "maxLength": 300 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgId", "branchId", "amountMinor", "currency", "shift", "date", "employeeName", "paymentMethod", "status", "poolRule", "notes", "recordedBy", "createdAt", "updatedAt"]
    },
