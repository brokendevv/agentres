  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and active tenant pointer"
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
